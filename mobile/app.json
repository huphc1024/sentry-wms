{
  "expo": {
    "name": "Sơn Lộc WMS",
    "slug": "sonloc-wms",
    "version": "1.29.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonloc.wms"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.sonloc.wms",
      "versionCode": 10,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Sơn Lộc WMS quét mã vạch và mã QR."
        }
      ],
      "./plugins/chainway-scanner",
      "./plugins/with-cleartext-traffic"
    ],
    "extra": {
      "eas": {
        "projectId": "8df87216-03e6-4715-acbc-33f9fd23582d"
      }
    },
    "owner": "mhightower932"
  }
}
